# Copy to .env and adjust for your environment.

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://ruknalharir.com

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Initial admin account — created automatically on first run if no users exist.
# Leave blank to skip auto-seeding (you can seed later with `npm run seed`).
ADMIN_NAME=Rukn Admin
ADMIN_EMAIL=admin@ruknalharir.com
ADMIN_PASSWORD=change-this-strong-password

# Outbound mail (contact form notifications) — optional.
# If left blank, the contact form still works; emails are just skipped (logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rukn Al Harir Website" <no-reply@ruknalharir.com>
MAIL_TO=info@ruknalharir.com
